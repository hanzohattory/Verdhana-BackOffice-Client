procedure TdmLookup.cdsLuChargeByMarketCalcFields(DataSet: TDataSet);
begin
  if cdsLuChargeByMarketBASIS.AsString = 'R' then
  begin
    cdsLuChargeByMarketDESCRIPTION.AsString := 'Charge Rate: ' +
      cdsLuChargeByMarketRATE.AsString + '% ';

    if cdsLuChargeByMarketRATE_SOURCE.AsString = 'TV' then
      cdsLuChargeByMarketDESCRIPTION.AsString := cdsLuChargeByMarketDESCRIPTION.AsString +
        'from Total Value'
    else if cdsLuChargeByMarketRATE_SOURCE.AsString = 'CO' then
      cdsLuChargeByMarketDESCRIPTION.AsString := cdsLuChargeByMarketDESCRIPTION.AsString +
        'as Commission Only'
    else if cdsLuChargeByMarketRATE_SOURCE.AsString = 'CV' then
      cdsLuChargeByMarketDESCRIPTION.AsString := cdsLuChargeByMarketDESCRIPTION.AsString +
        'as Commission + VAT';
  end

  else if cdsLuChargeByMarketBASIS.AsString = 'A' then
  begin
    cdsLuChargeByMarketDESCRIPTION.AsString := 'Charge Amount: ' +
      cdsLuChargeByMarketAMOUNT.AsString;
  end

  else if cdsLuChargeByMarketBASIS.AsString = 'T' then
  begin
    cdsLuChargeByMarketDESCRIPTION.AsString := 'Charge Table ID: ' +
      cdsLuChargeByMarketCHARGE_TABLE_ID.AsString;
  end;
end;

procedure TdmLookup.cdsLuChargeCalcFields(DataSet: TDataSet);
begin
  if cdsLuChargeBASIS.AsString = 'R' then
  begin
    cdsLuChargeDESCRIPTION.AsString := 'Charge Rate: ' +
      cdsLuChargeRATE.AsString + '% ';

    if cdsLuChargeRATE_SOURCE.AsString = 'TV' then
      cdsLuChargeDESCRIPTION.AsString := cdsLuChargeDESCRIPTION.AsString +
        'from Total Value'
    else if cdsLuChargeRATE_SOURCE.AsString = 'CO' then
      cdsLuChargeDESCRIPTION.AsString := cdsLuChargeDESCRIPTION.AsString +
        'as Commission Only'
    else if cdsLuChargeRATE_SOURCE.AsString = 'CV' then
      cdsLuChargeDESCRIPTION.AsString := cdsLuChargeDESCRIPTION.AsString +
        'as Commission + VAT';
  end

  else if cdsLuChargeBASIS.AsString = 'A' then
  begin
    cdsLuChargeDESCRIPTION.AsString := 'Charge Amount: ' +
      cdsLuChargeAMOUNT.AsString;
  end

  else if cdsLuChargeBASIS.AsString = 'T' then
  begin
    cdsLuChargeDESCRIPTION.AsString := 'Charge Table ID: ' +
      cdsLuChargeCHARGE_TABLE_ID.AsString;
  end;
end;

procedure TdmLookup.cdsLuCommByMarketCalcFields(DataSet: TDataSet);
begin
  if cdsLuCommByMarketCALC_METHOD.AsString = 'R' then
