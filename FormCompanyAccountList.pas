var
  frmCompanyAccList: TfrmCompanyAccList;

implementation

{$R *.dfm}

uses DataGlobal, FormCompAccountHouse, FormCompAccountBank;

procedure TfrmCompanyAccList.DataContainerGetEditorClass(
  var AFormClass: TNFormClass);
begin
  inherited;
  AFormClass := TfrmCompAccountHouse;

  if (cdsCompAccListACCTYPE.AsString = 'H') and (cdsCompAccListACCSUBTYPE.AsString = 'S') then
  begin
    AFormClass := TfrmCompAccountHouse;
  end
  else if (cdsCompAccListACCTYPE.AsString = 'B') and (cdsCompAccListACCSUBTYPE.AsString = 'S') then
  begin
    AFormClass := TfrmCompAccountBank;
  end;

end;

procedure TfrmCompanyAccList.FormCreate(Sender: TObject);
begin
  inherited;
  with dmGlobal.IntDataLookup do
  begin
    cdsLuAccType.Close;
    cdsLuAccType.Open;

    cdsLuInterest.Close;
    cdsLuInterest.Open;

    cdsLuActLedgerType.Close;
    cdsLuActLedgerType.Open;

    cdsLuTransType.Close;
    cdsLuTransType.Open;
  end;

  cdsEntAccSelect.Close;
  cdsEntAccSelect.Open;

  cdsCompAccList.Close;
  cdsCompAccList.Open;

  cdsCompAccListUpd.Close;
  cdsCompAccListUpd.Open;

end;

initialization
RegisterClass(TfrmCompanyAccList);

end.
