var
  oMainWnd: HWND;
  frmSplash: TfrmNFECSplash;
  i: integer;
  sParam, sHelp: string;
  LoginDlg: TForm;
  sUserID, sPassword: string;
  bFinish: boolean;
  sAppPath: string;
  sLogonResult: string;

begin

//  oMainWnd := Windows.FindWindow(APP_ID, '');
//  if (oMainWnd <> 0) then
//    Exit;

  if CreateMutex(nil, True, '{61CED94A-D476-4CE3-9F80-7CE162532858}') = 0 then
    RaiseLastOSError;

  if GetLastError = ERROR_ALREADY_EXISTS then
  begin
    MessageDlg('Nayaga Application Client Already Running.' + #13#10
      + 'Please check on your task manager!', mtError, [mbOK], 0);
//    Exit;
    Application.Terminate;
  end;


  {$DEFINE NRUNTIME}

  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.Title := 'Nayaga iBanking System';
  Application.CreateForm(TdmGlobal, dmGlobal);
  try
    dmGlobal.StartEngine;
    dmGlobal.SynchronizeApplication;

//    if not dmGlobal.SynchronizeApplication then
//      dmGlobal.CheckAppVersion;
  except
    on E:Exception do
    begin
      MessageDlg('Could not connect to Kalacakra/Nayaga App Server '+E.ClassName+':'+E.Message, mtError,[mbOK],0);
//      Exit;
      Application.Terminate;
    end;
  end;

  bFinish := False;

  repeat
    LoginDlg := TfrmLoginDialog.Create(nil);
    if LoginDlg.ShowModal = mrOK then
    begin
      sUserID := TfrmLoginDialog(LoginDlg).txtUserID.Text;
      sPassword := TfrmLoginDialog(LoginDlg).txtPassword.Text;


      FreeAndNil(LoginDlg);
      sLogonResult := dmGlobal.Login(sUserID, sPassword);
      if sLogonResult = '-maknyos-' then
      begin
        dmGlobal.UserID := sUserID;
        bFinish := true;


        frmSplash := TfrmNFECSplash.Create(nil);
        frmSplash.Show;
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Initialize Application ......';
        frmSplash.pbProgress.Position := 5;
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Initialize DataGlobal ......';
        frmSplash.pbProgress.Position := 10;
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Initialize Main Form ......';
        frmSplash.pbProgress.Position := 15;
        Application.CreateForm(TfrmMain, frmMain); // process bar 5%
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Initialization Completed .....';
        frmSplash.pbProgress.Position := 20;
        ChangeSplashProgressBarPosition(20); // adding the rest if progress bar position is odd
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare User Menu Permission .....';
        frmSplash.pbProgress.Position := 30;
        dmGlobal.menuBar.OpenUserPermission(sUserID);
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare User Static Data Permission .....';
        frmSplash.pbProgress.Position := 45;
        dmGlobal.menuBarStatic.OpenUserPermission(sUserID);//User Permission For Static Data New 20190311
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare User Report Permission .....';
        frmSplash.pbProgress.Position := 60;
        dmGlobal.menuBarReport.OpenUserPermission(sUserID);//User Permission For Report New 20170109
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare User Favorites Menu .....';
        frmSplash.pbProgress.Position := 65;
        dmGlobal.OpenUserFavorites(sUserID);
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare User Admin Data Permission .....';
        frmSplash.pbProgress.Position := 70;
        dmGlobal.menuBarAdmin.OpenUserPermission(sUserID);//User Permission For Admin Menu Bar
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Prepare Data Lookup .....';
        frmSplash.pbProgress.Position := 95;
        dmGlobal.IntDataLookup.LoadDataLookup;
        Application.ProcessMessages;

        frmSplash.lblProgress.Caption := 'Application ready .....';
        ChangeSplashProgressBarPosition(100);
        Application.ProcessMessages;

        frmSplash.Close;
        frmSplash.Free;

//        dmGlobal.idTCPClient.Connect;
//        if dmGlobal.idTCPClient.Connected then
//          dmGlobal.tmrHeartbeat.Enabled := True;

        Application.Run;

      end
      else
      begin

        sHelp := 'Login Failed : ' + sLogonResult;
        MessageBox(GetDesktopWindow, PWideChar(sHelp), PWideChar('User Login Error'), MB_OK or MB_ICONERROR);
        bFinish := False;

      end;
    end
    else
    begin
      bFinish := True;
      //dmGlobal.ActiveSession.SessionUnregister;
      FreeAndNil(LoginDlg);

      dmGlobal.DeinitializeEngine;//DataConnector issue
      dmGlobal.Free;

    end;
  until bFinish;


//  Application.CreateForm(TfrmMain, frmMain);
//  Application.CreateForm(TdmGlobal, dmGlobal);
//  Application.CreateForm(TfrmLoginDialog, frmLoginDialog);
//  Application.Run;
end.

