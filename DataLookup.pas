procedure TdmLookup.cdsLuCompanyBanksCalcFields(DataSet: TDataSet);
begin
  cdsLuCompanyBanksBANKDESC.AsString := cdsLuCompanyBanksBNCODE.AsString
    + ' - ' + cdsLuCompanyBanksBANKACCNO.AsString
    + ' (' + cdsLuCompanyBanksCCYCODE.AsString + ')';
end;

procedure TdmLookup.cdsLuInterestCalcFields(DataSet: TDataSet);
begin
  cdsLuInterestDESCRIPTION.AsString := 'Currency: ' + cdsLuInterestCCY.AsString;

  if cdsLuInterestCALCMETHOD.AsString = 'R' then
    cdsLuInterestDESCRIPTION.AsString := cdsLuInterestDESCRIPTION.AsString +
      ', Interest Rate: ' + cdsLuInterestINTERESTRATE.AsString + '%'
  else if cdsLuInterestCALCMETHOD.AsString = 'T' then
    cdsLuInterestDESCRIPTION.AsString := cdsLuInterestDESCRIPTION.AsString +
      ', Interest Table: ' + cdsLuInterestINTERESTTABLE.AsString;

  if cdsLuInterestCALCBASIS.AsString = 'S' then
    cdsLuInterestDESCRIPTION.AsString := cdsLuInterestDESCRIPTION.AsString +
      ', Calc Basis: Simple'
  else if cdsLuInterestCALCBASIS.AsString = 'C' then
    cdsLuInterestDESCRIPTION.AsString := cdsLuInterestDESCRIPTION.AsString +
      ', Calc Basis: Compound';

  cdsLuInterestDESCRIPTION.AsString := cdsLuInterestDESCRIPTION.AsString +
    ', Interest Day: ' + cdsLuInterestINTERESTDAY.AsString;
end;

procedure TdmLookup.cdsLuSITypeCalcFields(DataSet: TDataSet);
begin
  cdsLuSITypeSIDESC.AsString := cdsLuSITypeSITYPE.AsString + ': '
    + cdsLuSITypeSITYPENAME.AsString;
end;

function TdmLookup.GetReportTC(AReportID: Integer): string;
begin
  Result := '';

  if not cdsLuReportTC.Active then
    cdsLuReportTC.Open
  else
    cdsLuReportTC.Refresh;

  if cdsLuReportTC.Locate('REPORTID', AReportID, []) then
    Result := cdsLuReportTCREPORTFOLDER.AsString + cdsLuReportTCREPORT_FILENAME.AsString +'.fr3';
end;

function TdmLookup.GetStockCode(AStockID: Integer): string;
begin
  if not cdsLuInstrumentAll.Active then
    cdsLuInstrumentAll.Open;

  if cdsLuInstrumentAll.Locate('INSTRUMENT_ID', AStockID, []) then
    Result := cdsLuInstrumentAllLOCALCODE.AsString
  else
    Result := '';
end;

